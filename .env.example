# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Models
LLM_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text

# Vector store
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=knowledge_base

# Documents
DOCUMENTS_PATH=./documents

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
TOP_K=5
RELEVANCE_THRESHOLD=0.70

# Conversation
MAX_HISTORY_MESSAGES=6

# Debug
DEBUG=false