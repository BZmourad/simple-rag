# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text

# Vector store backend: "chroma" or "qdrant"
VECTOR_BACKEND=chroma

# Chroma
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=knowledge_base

# Qdrant (used when VECTOR_BACKEND=qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base

# Documents
DOCUMENTS_PATH=./documents
DEFAULT_COLLECTION=default

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
TOP_K=20                    # candidates before rerank
RERANK_TOP_K=5              # final chunks sent to LLM
RELEVANCE_THRESHOLD=0.70
HYBRID_ENABLED=true
HYBRID_DENSE_WEIGHT=0.7
HYBRID_SPARSE_WEIGHT=0.3
RRF_K=60

# Reranker: "cross-encoder" or "none"
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

# OCR
OCR_ENABLED=true
OCR_LANG=eng+fra
OCR_DPI=300
OCR_MIN_CHARS=30

# History
HISTORY_DIR=./history
MAX_HISTORY_MESSAGES=6

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Eval
EVAL_DATASET_PATH=./eval/golden_dataset.json

# Debug
DEBUG=false

# RAGAS evaluation
RAGAS_ENABLED=true
RAGAS_JUDGE_MODEL=qwen3:8b
RAGAS_JUDGE_EMBEDDING=nomic-embed-text
RAGAS_DATASET_PATH=./eval/ragas_dataset.json

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300

# Query expansion
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_MODE=hyde          # "hyde", "multi_query", or "both"
QUERY_EXPANSION_NUM_QUERIES=3
QUERY_EXPANSION_HYDE_TEMP=0.7

# Graph RAG
GRAPH_RAG_ENABLED=false
GRAPH_EXTRACTION_METHOD=gliner     # "gliner", "llm", or "heuristic"
GRAPH_ENTITY_THRESHOLD=0.5
GRAPH_MAX_DEPTH=2

# JWT auth
AUTH_MODE=jwt                        # "jwt" or "apikey"
JWT_SECRET=3679657cd12348e7459603a36b358997a9a152cd1af8641cd41a82888c2bc93d  #openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

AUTH_ENABLED=true
API_KEYS=sk-rag-dev-1,sk-rag-dev-2
JWT_EXPIRE_MINUTES=60

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_PER_DAY=10000

# Reranker cache
RERANKER_CACHE_SIZE=1

# Admin credentials (for /auth/login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$LmszkZUH6INv/5lS7sGDNg$Jw5d5NRhLpvWjg5oBLFTDTec+L+jUmPFoElPr5qfow0              
# generate via: python -c "from pwdlib import PasswordHash; print(PasswordHash.recommended().hash('MySecretPass123'))"

# FalkorDB graph store
GRAPH_BACKEND=falkordb               # "falkordb", "networkx", or "neo4j"
FALKORDB_PATH=/opt/simple-rag/data/falkordb.db
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# RAGAS regression tracking
RAGAS_TRACKING_ENABLED=true
RAGAS_DB_PATH=/opt/simple-rag/data/ragas_history.db

# Celery beat
CELERY_BEAT_ENABLED=true
CELERY_INGEST_SCHEDULE_MINUTES=60

# Flower
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=monitoring:change-me