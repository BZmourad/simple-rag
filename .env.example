# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text

# Vector store backend: "chroma" or "qdrant"
VECTOR_BACKEND=chroma

# Chroma
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=knowledge_base

# Qdrant (used when VECTOR_BACKEND=qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base

# Documents
DOCUMENTS_PATH=./documents
DEFAULT_COLLECTION=default

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
TOP_K=20                    # candidates before rerank
RERANK_TOP_K=5              # final chunks sent to LLM
RELEVANCE_THRESHOLD=0.70
HYBRID_ENABLED=true
HYBRID_DENSE_WEIGHT=0.7
HYBRID_SPARSE_WEIGHT=0.3
RRF_K=60

# Reranker: "cross-encoder" or "none"
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

# OCR
OCR_ENABLED=true
OCR_LANG=eng+fra
OCR_DPI=300
OCR_MIN_CHARS=30

# History
HISTORY_DIR=./history
MAX_HISTORY_MESSAGES=6

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Eval
EVAL_DATASET_PATH=./eval/golden_dataset.json

# Debug
DEBUG=false

# RAGAS evaluation
RAGAS_ENABLED=true
RAGAS_JUDGE_MODEL=qwen3:8b
RAGAS_JUDGE_EMBEDDING=nomic-embed-text
RAGAS_DATASET_PATH=./eval/ragas_dataset.json

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300

# Query expansion
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_MODE=hyde          # "hyde", "multi_query", or "both"
QUERY_EXPANSION_NUM_QUERIES=3
QUERY_EXPANSION_HYDE_TEMP=0.7

# Graph RAG
GRAPH_RAG_ENABLED=false
GRAPH_EXTRACTION_METHOD=gliner     # "gliner", "llm", or "heuristic"
GRAPH_ENTITY_THRESHOLD=0.5
GRAPH_MAX_DEPTH=2

# Auth
AUTH_ENABLED=true
API_KEYS=sk-rag-dev-1,sk-rag-dev-2
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_DAY=500

# Reranker cache
RERANKER_CACHE_SIZE=1