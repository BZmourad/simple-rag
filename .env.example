# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text

# Vector store backend: "chroma" or "qdrant"
VECTOR_BACKEND=chroma

# Chroma
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=knowledge_base

# Qdrant (used when VECTOR_BACKEND=qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base

# Documents
DOCUMENTS_PATH=./documents
DEFAULT_COLLECTION=default

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
TOP_K=20                    # candidates before rerank
RERANK_TOP_K=5              # final chunks sent to LLM
RELEVANCE_THRESHOLD=0.70
HYBRID_ENABLED=true
HYBRID_DENSE_WEIGHT=0.7
HYBRID_SPARSE_WEIGHT=0.3
RRF_K=60

# Reranker: "cross-encoder" or "none"
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

# OCR
OCR_ENABLED=true
OCR_LANG=eng+fra
OCR_DPI=300
OCR_MIN_CHARS=30

# History
HISTORY_DIR=./history
MAX_HISTORY_MESSAGES=6

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Eval
EVAL_DATASET_PATH=./eval/golden_dataset.json

# Debug
DEBUG=false