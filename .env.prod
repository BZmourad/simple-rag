# ========================================================
# Ollama
# ========================================================
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text

# ========================================================
# Vector store backend
# ========================================================
# Allowed values: chroma, qdrant
VECTOR_BACKEND=chroma

CHROMA_PATH=/opt/simple-rag/chroma_db
CHROMA_COLLECTION=knowledge_base

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base

# ========================================================
# Documents
# ========================================================
DOCUMENTS_PATH=/opt/simple-rag/documents
DEFAULT_COLLECTION=default

# ========================================================
# Chunking
# ========================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ========================================================
# Retrieval
# ========================================================
TOP_K=20
RERANK_TOP_K=5
RELEVANCE_THRESHOLD=0.70
HYBRID_ENABLED=true
HYBRID_DENSE_WEIGHT=0.7
HYBRID_SPARSE_WEIGHT=0.3
RRF_K=60

# ========================================================
# Reranker
# ========================================================
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true
RERANKER_CACHE_SIZE=1

# ========================================================
# OCR
# ========================================================
OCR_ENABLED=true
OCR_LANG=eng+fra
OCR_DPI=300
OCR_MIN_CHARS=30

# ========================================================
# History
# ========================================================
HISTORY_DIR=/opt/simple-rag/history
MAX_HISTORY_MESSAGES=6

# ========================================================
# API server
# ========================================================
API_HOST=0.0.0.0
API_PORT=8000

# ========================================================
# Eval
# ========================================================
EVAL_DATASET_PATH=/opt/simple-rag/eval/golden_dataset.json
RAGAS_ENABLED=true
RAGAS_JUDGE_MODEL=qwen3:8b
RAGAS_JUDGE_EMBEDDING=nomic-embed-text
RAGAS_DATASET_PATH=/opt/simple-rag/eval/ragas_dataset.json
RAGAS_TRACKING_ENABLED=true
RAGAS_DB_PATH=/opt/simple-rag/data/ragas_history.db

# ========================================================
# Celery
# ========================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300
CELERY_BEAT_ENABLED=true
CELERY_INGEST_SCHEDULE_MINUTES=60

# ========================================================
# Query expansion
# ========================================================
QUERY_EXPANSION_ENABLED=true
# Allowed values: hyde, multi_query, both
QUERY_EXPANSION_MODE=hyde
QUERY_EXPANSION_NUM_QUERIES=3
QUERY_EXPANSION_HYDE_TEMP=0.7

# ========================================================
# Graph RAG
# ========================================================
GRAPH_RAG_ENABLED=false
# Allowed values: gliner, llm, heuristic
GRAPH_EXTRACTION_METHOD=heuristic
GRAPH_ENTITY_THRESHOLD=0.5
GRAPH_MAX_DEPTH=2
# Allowed values: falkordb, networkx, neo4j
GRAPH_BACKEND=falkordb
FALKORDB_PATH=/opt/simple-rag/data/falkordb.db
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ========================================================
# Auth (JWT)
# ========================================================
AUTH_ENABLED=true
# Allowed values: jwt, apikey
AUTH_MODE=jwt
JWT_SECRET=3679657cd12348e7459603a36b358997a9a152cd1af8641cd41a82888c2bc93d
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
JWT_EXPIRE_MINUTES=60
API_KEYS=sk-rag-dev-1,sk-rag-dev-2

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$LmszkZUH6INv/5lS7sGDNg$Jw5d5NRhLpvWjg5oBLFTDTec+L+jUmPFoElPr5qfow0

# ========================================================
# Rate limiting
# ========================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_PER_DAY=10000

# ========================================================
# Flower
# ========================================================
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=monitoring:change-me

# ========================================================
# Debug
# ========================================================
DEBUG=false

NGINX_SERVER_NAME=rag.mouradbz.com

# ========================================================
# API / Gunicorn
# ========================================================
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
WORKERS=4


# ========================================================
# LLM Provider
# ========================================================
# "llamacpp" (local), "openrouter" (cloud), or "gemini" (cloud)
LLM_PROVIDER=llamacpp

# --- llama.cpp (local) ---
LLAMACPP_BASE_URL=http://127.0.0.1:8080
LLAMACPP_MODEL=local
LLAMACPP_TIMEOUT=180

# --- OpenRouter (cloud) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Gemini (cloud) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ========================================================
# Embeddings (keep local via Ollama or use Gemini)
# ========================================================
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434